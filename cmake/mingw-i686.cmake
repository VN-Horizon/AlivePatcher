# 32 位 MinGW-w64 工具链
set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR i686)

# 优先使用劳资 i686 编译器
find_program(_ALIVE_I686_GCC
        NAMES i686-w64-mingw32-gcc gcc
        PATHS
        "D:/DNV/tiny_softs/cli-bin/mingw32/bin"
        ENV PATH
        REQUIRED)

get_filename_component(_ALIVE_MINGW32_BIN "${_ALIVE_I686_GCC}" DIRECTORY)

set(CMAKE_C_COMPILER "${_ALIVE_MINGW32_BIN}/gcc.exe" CACHE FILEPATH "" FORCE)
set(CMAKE_RC_COMPILER "${_ALIVE_MINGW32_BIN}/windres.exe" CACHE FILEPATH "" FORCE)
set(CMAKE_ADDR2LINE "${_ALIVE_MINGW32_BIN}/addr2line.exe" CACHE FILEPATH "" FORCE)
set(CMAKE_AR "${_ALIVE_MINGW32_BIN}/ar.exe" CACHE FILEPATH "" FORCE)
set(CMAKE_RANLIB "${_ALIVE_MINGW32_BIN}/ranlib.exe" CACHE FILEPATH "" FORCE)
set(CMAKE_NM "${_ALIVE_MINGW32_BIN}/nm.exe" CACHE FILEPATH "" FORCE)
set(CMAKE_OBJCOPY "${_ALIVE_MINGW32_BIN}/objcopy.exe" CACHE FILEPATH "" FORCE)
set(CMAKE_OBJDUMP "${_ALIVE_MINGW32_BIN}/objdump.exe" CACHE FILEPATH "" FORCE)
set(CMAKE_STRIP "${_ALIVE_MINGW32_BIN}/strip.exe" CACHE FILEPATH "" FORCE)
set(CMAKE_LINKER "${_ALIVE_MINGW32_BIN}/ld.exe" CACHE FILEPATH "" FORCE)

# 避免误用到 64 位
set(CMAKE_FIND_ROOT_PATH "${_ALIVE_MINGW32_BIN}/..")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
